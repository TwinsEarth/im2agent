# IM2Agent 环境变量样例（复制为 .env 并按需填写；留空则使用内置默认值）
# 所有变量均为可选；不设置时 demo 以内存存储、无鉴权、无 LLM 降级运行。

# ---- 服务监听 ----
# 监听地址，默认 :8080
ADDR=:8080

# ---- 运维鉴权（v0.9-prod 引入）----
# 设置后，/api/admin/* 与 /admin/ 需要请求头 Authorization: Bearer <token>
# 强烈建议在公网部署时设置一个强随机值
# ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- 大模型（OpenAI 兼容，v0.7-llm）----
# 留空或请求失败时自动降级为模板兜底，不影响审批闭环
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat
