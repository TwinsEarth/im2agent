[Unit]
Description=IM2Agent - AI Native Hybrid Human-Agent IM Platform
Documentation=https://github.com/TwinsEarth/im2agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=im2agent
Group=im2agent
WorkingDirectory=/opt/im2agent
# 可选环境变量文件（ADMIN_TOKEN / OPENAI_* / LLM_MODEL）；文件不存在时不报错
EnvironmentFile=-/opt/im2agent/.env
ExecStart=/opt/im2agent/im2agent -addr :8080
Restart=always
RestartSec=3
# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/im2agent
LimitNOFILE=65536
# v0.3.2：资源限制（防止内存泄漏拖垮整机）
MemoryLimit=512M
CPUQuota=1.0
# v0.3.2：OOM 评分（比系统进程更晚被杀）
OOMScoreAdjust=-100
# 日志到 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=im2agent

[Install]
WantedBy=multi-user.target
