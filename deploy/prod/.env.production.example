# IM2Agent 生产环境变量样例（复制为 .env 并填写强随机值）
# 用法：cp .env.production.example deploy/prod/.env && cd deploy/prod && docker compose up -d

# ---- 域名（Caddy 自动向 Let's Encrypt 申请证书）----
DOMAIN=im2agent.example.com

# ---- 运维鉴权（必填，强随机）----
# 生成：openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---- 大模型（可选）----
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
LLM_MODEL=deepseek-chat

# ---- PostgreSQL（可选；demo 默认内存版）----
POSTGRES_PASSWORD=change-me-to-a-strong-password
# 生产切换 PG 时由 im2agent 读取（与 compose 中 postgres 服务对齐）
DATABASE_URL=postgres://im2agent:change-me-to-a-strong-password@postgres:5432/im2agent?sslmode=disable
